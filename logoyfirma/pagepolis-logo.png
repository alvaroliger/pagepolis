<svg width="520" height="150" viewBox="0 0 520 150" xmlns="http://www.w3.org/2000/svg" font-family="'Segoe UI', Helvetica, Arial, sans-serif">
  <defs>
    <linearGradient id="badge" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1F2A4A"/>
      <stop offset="1" stop-color="#2E3F6E"/>
    </linearGradient>
  </defs>

  <!-- Icon badge -->
  <rect x="18" y="31" width="88" height="88" rx="22" fill="url(#badge)"/>

  <!-- "page" sheet -->
  <path d="M48 52 h28 l12 12 v34 a4 4 0 0 1 -4 4 H48 a4 4 0 0 1 -4 -4 V56 a4 4 0 0 1 4 -4 Z" fill="#FFFFFF"/>
  <path d="M76 52 v12 h12 Z" fill="#C9D2EC"/>
  <!-- accent "polis" dot / pin -->
  <circle cx="79" cy="93" r="11" fill="#16B8A6"/>
  <circle cx="79" cy="91" r="3.4" fill="#FFFFFF"/>
  <path d="M79 100 l5 9 h-10 Z" fill="#16B8A6"/>

  <!-- Wordmark -->
  <text x="128" y="92" font-size="52" font-weight="700" letter-spacing="-0.5">
    <tspan fill="#1F2A4A">Page</tspan><tspan fill="#16B8A6">Polis</tspan>
  </text>
  <!-- Tagline (edítala a tu gusto) -->
  <text x="130" y="116" font-size="15" letter-spacing="3" fill="#6B7280">CREACIÓN DE PÁGINAS WEB</text>
</svg>
