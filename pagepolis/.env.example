# ==============================================================================
#  PAGEPOLIS — Plantilla de configuración
#  Copia este archivo a `.env` y rellena los valores. En el servidor de
#  producción (/var/www/pagepolis/.env) usa los valores reales de cada servicio.
# ==============================================================================

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME=Pagepolis
# En producción: APP_ENV=production y APP_DEBUG=false (NUNCA true en producción)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# En producción: https://pagepolis.com
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
# En producción usa "daily" para rotación de logs
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción: LOG_LEVEL=warning (o error)
LOG_LEVEL=debug

# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite es suficiente para el lanzamiento. Si se escala, migrar a MySQL/Postgres.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

# ── Sesión / Cola / Caché ─────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS añade: SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# La cola usa la BD. En producción ejecuta un worker (Supervisor/systemd):
#   php artisan queue:work --tries=3
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Email ─────────────────────────────────────────────────────────────────────
# En desarrollo "log" escribe los correos en storage/logs/laravel.log.
# En PRODUCCIÓN configura un proveedor real (Resend recomendado):
#   MAIL_MAILER=resend  y  RESEND_API_KEY=re_xxx
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@pagepolis.com"
MAIL_FROM_NAME="${APP_NAME}"
# Correo de SOPORTE (créalo como buzón en Dinahosting). Aparece en la web, en las
# páginas legales y en los mensajes de error de la app.
SUPPORT_EMAIL="soporte@pagepolis.com"
# RESEND_API_KEY=
# POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── IA (Anthropic / Claude) ───────────────────────────────────────────────────
# Clave de https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Modelo para usuarios DE PAGO (máxima calidad).
ANTHROPIC_MODEL=claude-opus-4-8
# Modelo para usuarios GRATIS (excelente calidad, mucho más barato → protege margen).
ANTHROPIC_MODEL_FREE=claude-sonnet-4-6
# GUARDIÁN DE PRESUPUESTO: topes de gasto de IA. Al alcanzarlos, las generaciones
# se pausan automáticamente y NUNCA se gasta de más sin tu permiso (protege frente
# a abuso por bots o a mano). Súbelos cuando quieras permitir más gasto.
# 0 = sin tope (NO recomendado).
AI_MONTHLY_BUDGET_USD=50
# Tope diario opcional (USD). Vacío = se deriva del mensual/10.
AI_DAILY_BUDGET_USD=

# ── Stripe (pagos) ────────────────────────────────────────────────────────────
# Claves de https://dashboard.stripe.com/  (usa claves LIVE en producción).
STRIPE_KEY=pk_live_xxxxxxxx
STRIPE_SECRET=sk_live_xxxxxxxx
# Secreto del webhook (https://pagepolis.com/stripe/webhook), evento de Stripe.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# IDs de precio creados en Stripe (producto "Pagepolis").
STRIPE_PRICE_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxx
# Moneda de Cashier (los planes están en euros).
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=es

# ── WhatsApp Business (Meta) ──────────────────────────────────────────────────
# App en https://developers.facebook.com (Business > WhatsApp).
WHATSAPP_TOKEN=xxxxxxxx
WHATSAPP_PHONE_ID=xxxxxxxx
WHATSAPP_APP_SECRET=xxxxxxxx
# Token de verificación del webhook (lo eliges tú, debe coincidir en Meta).
WHATSAPP_VERIFY_TOKEN=pagepolis_whatsapp_2024

# ── Dominios (Dinahosting) ────────────────────────────────────────────────────
DINAHOSTING_USER=xxxxxxxx
DINAHOSTING_PASS=xxxxxxxx
# Datos REALES del titular para el registro WHOIS (ICANN los exige; si son falsos
# el registrador puede rechazar o suspender el dominio).
OWNER_ADDRESS="Calle de ejemplo 1"
OWNER_CITY="Madrid"
OWNER_ZIP="28001"
OWNER_COUNTRY="ES"
OWNER_PHONE="+34.600000000"

# ── DNS (Cloudflare) ──────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=xxxxxxxx
CLOUDFLARE_ZONE_ID=xxxxxxxx

# ── Infraestructura / hosting de sitios de usuarios ───────────────────────────
SITES_BASE_PATH=/var/www/pagepolis-sites
SITES_BASE_DOMAIN=pagepolis.com
# IP pública del servidor (para los registros A de los dominios de usuarios).
SERVER_PUBLIC_IP=207.180.193.214

# ── Anti-abuso (límites del tier gratuito) ────────────────────────────────────
# Topes de cantidad para usuarios sin suscripción (los de pago no tienen tope).
FREE_MAX_PROJECTS=10
FREE_MAX_PUBLISHED=3

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_STRIPE_KEY="${STRIPE_KEY}"
